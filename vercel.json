{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "admin.html,b2b.html,index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/admin",
      "destination": "/server.js"
    },
    {
      "source": "/b2b",
      "destination": "/server.js"
    }
  ]
}
