# Supabase Configuration (Required for Cloud DB)
SUPABASE_URL=https://ipvbfrhiukuthsppzzxh.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Admin Dashboard Password (Default: admin1234)
